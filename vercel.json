{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/version.json",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/version.json"
    },
    {
      "src": "/Guida_Praga_Genitori.md",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/Guida_Praga_Genitori.md"
    },
    {
      "src": "/(.*)",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "dest": "/index.html"
    }
  ]
}
